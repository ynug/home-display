import { Theme } from "theme.slint";
import { Card, StatusDot, SectionTitle, Divider } from "components.slint";
import { SettingsView, DiagRow, Health } from "types.slint";

// Keyboard key label, e.g. [P].
component KeyCap inherits Rectangle {
    in property <string> text;
    height: 34px;
    width: max(34px, label.preferred-width + 18px);
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.hairline;
    background: Theme.surface-sunken;
    label := Text {
        text: root.text;
        font-size: 18px;
        font-weight: 600;
        color: Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One setting: label and its current value (read-only; edit config.toml).
component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> key;
    height: 50px;
    spacing: 12px;
    Text {
        text: root.label;
        width: 230px;
        font-size: 21px;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        font-size: 24px;
        font-weight: 600;
        color: Theme.text-primary;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
    // config.toml key, e.g. "[display] profile".
    Text {
        text: root.key;
        font-size: 15px;
        color: Theme.text-faint;
        vertical-alignment: center;
    }
}

component KeyHelp inherits HorizontalLayout {
    in property <string> key;
    in property <string> label;
    spacing: 10px;
    VerticalLayout { alignment: center; KeyCap { text: root.key; } }
    Text { text: root.label; font-size: 18px; color: Theme.text-secondary; vertical-alignment: center; }
}

component KV inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    spacing: 16px;
    Text { text: root.key; width: 150px; font-size: 18px; color: Theme.text-tertiary; }
    Text { text: root.value; font-size: 18px; color: Theme.text-secondary; horizontal-stretch: 1; overflow: elide; }
}

export component SettingsScreen inherits Rectangle {
    in property <SettingsView> data;

    VerticalLayout {
        padding: 44px;
        padding-top: 36px;
        spacing: 24px;

        HorizontalLayout {
            height: 56px;
            spacing: 20px;
            Text { text: "設定と診断"; font-size: 40px; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }
            Text { text: root.data.version; font-size: 20px; color: Theme.text-tertiary; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            KeyHelp { key: "S"; label: "閉じる"; }
            KeyHelp { key: "Ctrl+Q"; label: "終了"; }
        }

        HorizontalLayout {
            spacing: Theme.gap;
            vertical-stretch: 1;

            // ── Display settings (read-only: edit config.toml) ──
            Card {
                width: 720px;
                VerticalLayout {
                    padding: 30px;
                    spacing: 6px;
                    SectionTitle { text: "表示設定"; trailing: root.data.mode-text; }

                    Row { label: "表示プロファイル"; value: root.data.profile-name; key: "[display] profile"; }
                    Text {
                        text: root.data.profile-detail;
                        font-size: 17px;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                    Divider { }
                    Row { label: "自動切り替え"; value: root.data.rotation-enabled ? "有効" : "無効"; key: "[rotation] enabled"; }
                    Row { label: "概要の表示時間"; value: root.data.overview-seconds + " 秒"; key: "overview_seconds"; }
                    Row {
                        label: "レーダー表示時間";
                        value: root.data.radar-seconds == 0 ? "自動 " + root.data.radar-auto-seconds + " 秒" : root.data.radar-seconds + " 秒";
                        key: "radar_seconds";
                    }
                    Row { label: "地図の縮尺"; value: root.data.radar-zoom-text; key: "[radar] map_zoom"; }
                    Divider { }
                    // How to change settings (there is no editing on screen).
                    Text {
                        text: "設定の変更は SSH で:  sudo home-display config edit";
                        font-size: 19px;
                        color: Theme.accent;
                    }
                    Text {
                        text: "保存すると自動でチェックし、問題がなければ再起動して反映します";
                        font-size: 16px;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                    if root.data.sensors.length > 0: Divider { }
                    if root.data.sensors.length > 0: SectionTitle { text: "室内センサー"; trailing: "config.toml の [sensors]"; }
                    for d in root.data.sensors: VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 12px;
                            height: 30px;
                            VerticalLayout { alignment: center; StatusDot { health: d.health; } }
                            Text { text: d.name; width: 70px; font-size: 19px; color: Theme.text-primary; vertical-alignment: center; }
                            Text { text: d.origin; width: 150px; font-size: 16px; color: Theme.text-tertiary; vertical-alignment: center; }
                            Text { text: d.next; font-size: 17px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            Text { text: d.last-success; font-size: 16px; color: Theme.text-tertiary; vertical-alignment: center; }
                        }
                        if d.error != "": Text {
                            text: d.error;
                            font-size: 15px;
                            color: Theme.warn;
                            overflow: elide;
                        }
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.gap;

            // ── Read-only configuration (edit config.toml to change) ──
            Card {
                VerticalLayout {
                    padding: 30px;
                    padding-bottom: 24px;
                    spacing: 8px;
                    SectionTitle { text: "設定ファイル"; trailing: "読み込み " + root.data.loaded-at; }
                    KV { key: "設定ファイル"; value: root.data.config-path; }
                    KV { key: "地点"; value: root.data.location-text; }
                    KV { key: "カレンダー"; value: root.data.ical-text; }
                    KV { key: "キャッシュ"; value: root.data.cache-dir; }
                    KV { key: "レーダー画像"; value: root.data.radar-memory; }
                }
            }

            // ── Diagnostics ──
            Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 30px;
                    spacing: 8px;
                    SectionTitle { text: "データソース"; }
                    HorizontalLayout {
                        spacing: 14px;
                        height: 30px;
                        Rectangle { width: 10px; }
                        Text { text: "名前"; width: 130px; font-size: 16px; color: Theme.text-faint; }
                        Text { text: "取得元"; width: 260px; font-size: 16px; color: Theme.text-faint; }
                        Text { text: "最終成功"; width: 130px; font-size: 16px; color: Theme.text-faint; }
                        Text { text: "次回"; width: 130px; font-size: 16px; color: Theme.text-faint; }
                        Text { text: "直近のエラー"; font-size: 16px; color: Theme.text-faint; horizontal-stretch: 1; }
                    }
                    for src in root.data.sources: HorizontalLayout {
                        spacing: 14px;
                        height: 44px;
                        VerticalLayout { alignment: center; StatusDot { health: src.health; } }
                        Text { text: src.name; width: 130px; font-size: 20px; color: Theme.text-primary; vertical-alignment: center; }
                        Text { text: src.origin; width: 260px; font-size: 18px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
                        Text { text: src.last-success; width: 130px; font-size: 18px; color: Theme.text-secondary; vertical-alignment: center; }
                        Text { text: src.next; width: 130px; font-size: 18px; color: Theme.text-tertiary; vertical-alignment: center; }
                        Text { text: src.error; font-size: 17px; color: src.error != "" ? Theme.warn : Theme.text-faint; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    }
                    Rectangle { height: 14px; }
                    SectionTitle { text: "最近の警告・エラー"; }
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 60px;
                        border-radius: Theme.radius-small;
                        background: Theme.surface-sunken;
                        clip: true;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 4px;
                            alignment: start;
                            if root.data.logs.length == 0: Text { text: "記録された警告はありません"; font-size: 17px; color: Theme.text-tertiary; }
                            for line in root.data.logs: Text {
                                text: line;
                                font-size: 16px;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
            }
        }
    }
}
