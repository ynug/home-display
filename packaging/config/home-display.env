# Environment for home-display.service. Installed as
# /etc/home-display/home-display.env with mode 0600 (root only).
# NEVER commit a real value of HOME_DISPLAY_ICAL_URL to git.
#
# The app itself reads only HOME_DISPLAY_ICAL_URL. Location, rotation, zoom,
# profile etc. are set on the settings screen (S → W) or in config.toml.

# Google Calendar → Settings → "Secret address in iCal format"
#HOME_DISPLAY_ICAL_URL=https://calendar.google.com/calendar/ical/REPLACE_ME/private-REPLACE_ME/basic.ics

# ── Display output (read by the Slint runtime, not by the app) ──
# Renderer: linuxkms-femtovg (GPU, default) or linuxkms-software (CPU fallback)
#SLINT_BACKEND=linuxkms-software
# Pick the connector / mode (run once with SLINT_DRM_OUTPUT=list or SLINT_DRM_MODE=list)
#SLINT_DRM_OUTPUT=HDMI-A-1
#SLINT_DRM_MODE=0
# Rotate the output: 0, 90, 180, 270
#SLINT_KMS_ROTATION=0
# 1280x720 panel with the 1920x1080 layout:
#SLINT_SCALE_FACTOR=0.6667

#RUST_LOG=info
