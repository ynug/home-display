import { Theme } from "theme.slint";
import { OverviewScreen } from "overview.slint";
import { RadarScreen } from "radar.slint";
import { SettingsScreen } from "settings.slint";
import {
    ScreenKind, HeaderData, ClockData, CalendarView, WeatherView, QuakeView,
    FooterView, RadarView, SettingsView, Health, PanelState, IndoorView,
} from "types.slint";

export { Theme }
export * from "types.slint";

export component MainWindow inherits Window {
    title: "Home Display";
    preferred-width: 1920px;
    preferred-height: 1080px;
    // Desktop preview: the layout is designed for exactly 1920×1080 logical
    // px, so the window is fixed (min = max ⇒ not resizable). On LinuxKMS
    // the output size is used as-is.
    in property <bool> fixed-size: false;
    min-width: fixed-size ? 1920px : 960px;
    min-height: fixed-size ? 1080px : 540px;
    max-width: fixed-size ? 1920px : 100000px;
    max-height: fixed-size ? 1080px : 100000px;
    background: #090D12;
    default-font-family: root.font-family;

    in property <string> font-family;
    in property <ScreenKind> screen: ScreenKind.overview;

    in property <HeaderData> header;
    in property <ClockData> clock;
    in property <CalendarView> calendar;
    in property <WeatherView> weather;
    in property <IndoorView> indoor;
    in property <QuakeView> quake;
    in property <FooterView> footer;
    in property <RadarView> radar;
    in property <[image]> radar-frames;
    in property <int> radar-frame-ms: 700;
    in property <SettingsView> settings;
    // Set instead of everything else when config.toml cannot be used.
    in property <string> config-error;
    in property <string> config-path;
    // Monospace, so the "^^^" under a TOML error lines up.
    in property <string> mono-font-family;

    // Every key press funnels into one callback so
    // that Rust's ScreenManager remains the single owner of navigation state.
    callback action(string);

    Rectangle {
        background: Theme.background;
    }

    if root.screen == ScreenKind.overview: OverviewScreen {
        header: root.header;
        clock: root.clock;
        calendar: root.calendar;
        weather: root.weather;
        indoor: root.indoor;
        quake: root.quake;
        footer: root.footer;
    }

    if root.screen == ScreenKind.radar: RadarScreen {
        header: root.header;
        clock: root.clock;
        weather: root.weather;
        indoor: root.indoor;
        radar: root.radar;
        frames: root.radar-frames;
        frame-ms: root.radar-frame-ms;
    }

    if root.screen == ScreenKind.settings: SettingsScreen {
        data: root.settings;
    }

    // A broken config.toml: say what is wrong and how to fix it, and wait
    // (rather than exiting into a restart loop with a black screen).
    if root.config-error != "": Rectangle {
        background: Theme.background;
        VerticalLayout {
            padding: 90px;
            spacing: 26px;
            alignment: center;
            Text { text: "設定ファイルにエラーがあります"; font-size: 52px; font-weight: 600; color: Theme.warn; }
            Text { text: root.config-path; font-size: 24px; color: Theme.text-secondary; }
            Rectangle {
                border-radius: Theme.radius-small;
                background: Theme.surface-sunken;
                VerticalLayout {
                    padding: 30px;
                    Text { text: root.config-error; font-size: 22px; font-family: root.mono-font-family; color: Theme.text-primary; wrap: word-wrap; }
                }
            }
            Text { text: "SSH で直してください:  sudo home-display config edit"; font-size: 30px; color: Theme.accent; }
            Text {
                text: "保存すると自動でチェックし、問題がなければ再起動して表示を再開します。Ctrl+Q で終了します。";
                font-size: 22px;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }
    }

    // Keyboard: only Ctrl+Q (quit) and S (settings / diagnostics, read-only).
    // Settings are changed in config.toml, never on screen, so a keyboard
    // plugged in for maintenance cannot change anything by accident.
    keys := FocusScope {
        key-pressed(event) => {
            // KMS may report Ctrl+Q as the control character U+0011 instead of "q".
            if (event.modifiers.control && (event.text.to-lowercase() == "q" || event.text == "\u{11}")) { root.action("quit"); return accept; }
            if (!event.modifiers.control && !event.modifiers.alt && event.text.to-lowercase() == "s") { root.action("key:s"); return accept; }
            accept
        }
    }

    // Mouse / touch input is disabled: the display runs with a keyboard only.
    // This area swallows pointer events and hides the cursor.
    TouchArea {
        mouse-cursor: none;
    }

    init => { keys.focus(); }
}
