# Copy to .env (git-ignored). mise loads it automatically (see mise.toml);
# without mise:  set -a; . ./.env; set +a
# Placeholders only — never commit real values.
#
# The app reads only one environment variable: the secret calendar URL.
# Everything else (location, rotation, zoom, profile …) is set on the settings
# screen (S → W to save) or in config.toml.

# Secret iCal URL (Google Calendar → Settings → Integrate calendar → "Secret address in iCal format")
HOME_DISPLAY_ICAL_URL=https://calendar.google.com/calendar/ical/REPLACE_ME/private-REPLACE_ME/basic.ics

# Optional: log level
#RUST_LOG=info,home_display=debug
