import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Card, StatusDot, Pill, SectionTitle, Divider, Button } from "components.slint";
import { SettingsView, DiagRow, Health } from "types.slint";

component Row inherits HorizontalLayout {
    in property <string> label;
    height: 58px;
    spacing: 16px;
    Text {
        text: root.label;
        width: 262px;
        font-size: 21px;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
    @children
}

component Stepper inherits HorizontalLayout {
    in property <int> value;
    in property <string> unit: "秒";
    // Shown instead of the number when set (e.g. "自動 19秒").
    in property <string> display;
    in property <length> value-width: 136px;
    callback dec;
    callback inc;
    spacing: 12px;
    Button { text: "−"; width: 64px; clicked => { root.dec(); } }
    Text {
        text: root.display != "" ? root.display : root.value + " " + root.unit;
        width: root.value-width;
        font-size: 26px;
        font-weight: 600;
        color: Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Button { text: "+"; width: 64px; clicked => { root.inc(); } }
}

component KV inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    spacing: 16px;
    Text { text: root.key; width: 170px; font-size: 18px; color: Theme.text-tertiary; }
    Text { text: root.value; font-size: 18px; color: Theme.text-secondary; horizontal-stretch: 1; overflow: elide; }
}

// Label + text field used by the location card.
component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 16px;
    height: 50px;
    Text {
        text: root.label;
        width: 230px;
        font-size: 20px;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
    @children
}

export component SettingsScreen inherits Rectangle {
    in property <SettingsView> data;
    // Location form fields (two-way with the window; Rust fills them when
    // the screen opens and reads them on "適用").
    in-out property <string> location-name;
    in-out property <string> location-coords;
    in-out property <string> radar-coords;
    in-out property <string> radar-name;
    callback action(string);

    VerticalLayout {
        padding: 44px;
        padding-top: 36px;
        spacing: 24px;

        HorizontalLayout {
            height: 56px;
            spacing: 20px;
            Text { text: "設定と診断"; font-size: 40px; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }
            Text { text: root.data.version; font-size: 20px; color: Theme.text-tertiary; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "キー操作: 1 概要 / 2 レーダー / S 設定 / Space 一時停止 / U 再取得 / Esc 戻る";
                font-size: 17px;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }
            Button { text: "閉じる"; clicked => { root.action("close"); } }
        }

        HorizontalLayout {
            spacing: Theme.gap;
            vertical-stretch: 1;

            // ── Display settings ──
            Card {
                width: 720px;
                VerticalLayout {
                    padding: 30px;
                    spacing: 10px;
                    SectionTitle { text: "表示設定"; trailing: root.data.mode-text; }

                    Row {
                        label: "表示プロファイル  (P)";
                        Button { text: "Full"; active: root.data.profile-index == 0; clicked => { root.action("profile:full"); } }
                        Button { text: "Balanced"; active: root.data.profile-index == 1; clicked => { root.action("profile:balanced"); } }
                        Button { text: "Low"; active: root.data.profile-index == 2; clicked => { root.action("profile:low"); } }
                    }
                    Text {
                        text: root.data.profile-detail;
                        font-size: 17px;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                    Divider { }
                    Row {
                        label: "自動切り替え  (A)";
                        Button {
                            text: root.data.rotation-enabled ? "有効" : "無効";
                            active: root.data.rotation-enabled;
                            width: 140px;
                            clicked => { root.action("rotation:toggle"); }
                        }
                        if root.data.rotation-paused: Pill { text: "一時停止中"; tone: Theme.warn; outlined: true; y: 8px; }
                    }
                    Row {
                        label: "概要の表示時間  ([ ])";
                        Stepper {
                            value: root.data.overview-seconds;
                            dec => { root.action("overview:-5"); }
                            inc => { root.action("overview:+5"); }
                        }
                    }
                    Row {
                        label: "レーダー表示時間  (- = 0)";
                        Stepper {
                            value: root.data.radar-seconds;
                            display: root.data.radar-seconds == 0 ? "自動 " + root.data.radar-auto-seconds + "秒" : "";
                            dec => { root.action("radar:-5"); }
                            inc => { root.action("radar:+5"); }
                        }
                        Button {
                            text: "自動";
                            width: 76px;
                            active: root.data.radar-seconds == 0;
                            clicked => { root.action("radar:auto"); }
                        }
                    }
                    Row {
                        label: "地図の縮尺  (, .)";
                        Stepper {
                            value: root.data.radar-zoom;
                            display: root.data.radar-zoom-text;
                            value-width: 220px;
                            dec => { root.action("zoom:-1"); }
                            inc => { root.action("zoom:+1"); }
                        }
                    }
                    Text {
                        text: "数字を小さくすると広い範囲、大きくすると詳しい表示（1 段階で範囲が 2 倍／半分）";
                        font-size: 16px;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                    Divider { }
                    HorizontalLayout {
                        spacing: 14px;
                        height: 56px;
                        Button { text: "保存  (W)"; clicked => { root.action("save"); } }
                        Button { text: "データを再取得  (U)"; clicked => { root.action("refresh"); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text {
                        text: root.data.save-message;
                        font-size: 18px;
                        color: Theme.accent;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                    KV { key: "設定ファイル"; value: root.data.config-path; }
                    KV { key: "UI上書き設定"; value: root.data.overrides-path; }
                    KV { key: "カレンダー"; value: root.data.ical-text; }
                    KV { key: "キャッシュ"; value: root.data.cache-dir; }
                    KV { key: "レーダー画像"; value: root.data.radar-memory; }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.gap;

            // ── Location (entered by hand; no search) ──
            Card {
                VerticalLayout {
                    padding: 30px;
                    padding-bottom: 24px;
                    spacing: 10px;
                    SectionTitle {
                        text: "地点";
                        trailing: "Google マップで地点を右クリックすると「緯度, 経度」をコピーできます";
                    }
                    Field {
                        label: "地点名";
                        LineEdit {
                            text <=> root.location-name;
                            placeholder-text: "例: 東京";
                            font-size: 20px;
                        }
                    }
                    Field {
                        label: "座標（緯度, 経度）";
                        LineEdit {
                            text <=> root.location-coords;
                            placeholder-text: "例: 35.6812, 139.7671";
                            font-size: 20px;
                        }
                    }
                    Field {
                        label: "雨雲の中心・表示名";
                        LineEdit {
                            text <=> root.radar-coords;
                            placeholder-text: "空欄 = 地点と同じ";
                            font-size: 20px;
                        }
                        LineEdit {
                            width: 200px;
                            text <=> root.radar-name;
                            placeholder-text: "中心の表示名";
                            font-size: 20px;
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        height: 52px;
                        Button { text: "適用"; width: 120px; clicked => { root.action("location:apply"); } }
                        Text {
                            text: "雨雲の中心は空欄なら地点と同じ。適用すると天気と雨雲を取り直します（保存は W）";
                            font-size: 17px;
                            color: Theme.text-tertiary;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }

            // ── Diagnostics ──
            Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 30px;
                    spacing: 8px;
                    SectionTitle { text: "データソース"; }
                    HorizontalLayout {
                        spacing: 14px;
                        height: 30px;
                        Rectangle { width: 10px; }
                        Text { text: "名前"; width: 130px; font-size: 16px; color: Theme.text-faint; }
                        Text { text: "取得元"; width: 260px; font-size: 16px; color: Theme.text-faint; }
                        Text { text: "最終成功"; width: 130px; font-size: 16px; color: Theme.text-faint; }
                        Text { text: "次回"; width: 130px; font-size: 16px; color: Theme.text-faint; }
                        Text { text: "直近のエラー"; font-size: 16px; color: Theme.text-faint; horizontal-stretch: 1; }
                    }
                    for src in root.data.sources: HorizontalLayout {
                        spacing: 14px;
                        height: 44px;
                        VerticalLayout { alignment: center; StatusDot { health: src.health; } }
                        Text { text: src.name; width: 130px; font-size: 20px; color: Theme.text-primary; vertical-alignment: center; }
                        Text { text: src.origin; width: 260px; font-size: 18px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
                        Text { text: src.last-success; width: 130px; font-size: 18px; color: Theme.text-secondary; vertical-alignment: center; }
                        Text { text: src.next; width: 130px; font-size: 18px; color: Theme.text-tertiary; vertical-alignment: center; }
                        Text { text: src.error; font-size: 17px; color: src.error != "" ? Theme.warn : Theme.text-faint; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    }
                    Rectangle { height: 14px; }
                    SectionTitle { text: "最近の警告・エラー"; }
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: Theme.radius-small;
                        background: Theme.surface-sunken;
                        clip: true;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 4px;
                            alignment: start;
                            if root.data.logs.length == 0: Text { text: "記録された警告はありません"; font-size: 17px; color: Theme.text-tertiary; }
                            for line in root.data.logs: Text {
                                text: line;
                                font-size: 16px;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
            }
        }
    }
}
